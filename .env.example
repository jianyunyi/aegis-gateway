# Copy to .env only as a template, then replace every empty secret with a random value.
# For an automatically generated local setup, run scripts/init-compose-env.sh instead.
MYSQL_USER=aegis
MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=
REDIS_PASSWORD=
JWT_SECRET=
SEED_DATA=false
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=
PROMPT_CAPTURE_ENABLED=false
PROMPT_RETENTION_DAYS=30
MAX_REQUEST_BODY_BYTES=2097152
CORS_ALLOWED_ORIGINS=
