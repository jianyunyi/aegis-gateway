# Non-secret Compose settings only. For local credentials, run:
#   ./scripts/init-compose-env.sh
# This generates .secrets/ under a mode-0700 directory; never commit it.
MYSQL_USER=aegis
SECRETS_DIR=../.secrets
APP_UID=10001
APP_GID=10001
SEED_DATA=false
BOOTSTRAP_ADMIN_USERNAME=
PROMPT_CAPTURE_ENABLED=false
PROMPT_RETENTION_DAYS=30
MAX_REQUEST_BODY_BYTES=2097152
CORS_ALLOWED_ORIGINS=
