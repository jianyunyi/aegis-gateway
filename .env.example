# AEGIS 网关环境变量示例（复制为 .env 或直接注入容器）
APP_ENV=dev
HTTP_ADDR=:8081
MYSQL_DSN=root:root@tcp(127.0.0.1:3303)/aegis?charset=utf8mb4&parseTime=True&loc=Local
REDIS_ADDR=127.0.0.1:6379
REDIS_PASSWORD=
AUTO_MIGRATE=true
# 上线配置：密钥通过 deploy/.env 注入（.env 不入库，见 docs/06 第 8 节）
# JWT_SECRET=<随机串>（同时用于提供商 Key 加密，改动后需重加密 api_key_enc）
# SEED_DATA=false（上线禁用演示数据）
JWT_SECRET=dev-secret-change-me
BILLING_INTERVAL_MINUTES=5
CACHE_TTL_SECONDS=600
