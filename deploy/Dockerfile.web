# AEGIS 管理后台镜像（标准多阶段构建，需网络执行 npm ci）。
# 说明：node_modules 含平台相关二进制（next-swc），必须用 npm ci 在目标平台安装，
# 不能复用宿主机 node_modules；无网络环境请用本地 `npm run dev`（见 README）。
FROM node:20-alpine AS deps
WORKDIR /app
ENV NEXT_TELEMETRY_DISABLED=1
ENV npm_config_registry=https://registry.npmmirror.com
COPY web/package.json web/package-lock.json* ./
RUN npm ci --no-audit --no-fund

FROM node:20-alpine AS builder
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY web/ .
ENV NEXT_TELEMETRY_DISABLED=1
# API 基地址与 /api 重写目标均由 docker-compose 通过构建参数注入：
# - 本地 Docker：浏览器走同源 /api，Next 重写到网关服务名（aegis-gateway:8080）
# - 公网部署：改为真实网关域名（如 Cloudflare 隧道），并把 NEXT_PUBLIC_API_PROXY 设为网关地址
ARG NEXT_PUBLIC_API_BASE=/api/v1/admin
ARG NEXT_PUBLIC_API_PROXY=http://aegis-gateway:8080/api/:path*
ENV NEXT_PUBLIC_API_BASE=$NEXT_PUBLIC_API_BASE
ENV NEXT_PUBLIC_API_PROXY=$NEXT_PUBLIC_API_PROXY
RUN npm run build

FROM node:20-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
COPY --from=builder /app/.next/standalone ./
COPY --from=builder /app/.next/static ./.next/static
COPY --from=builder /app/public ./public
EXPOSE 3000
CMD ["node", "server.js"]
